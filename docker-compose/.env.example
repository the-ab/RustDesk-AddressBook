# RustDesk AddressBook – GHCR-Image-Installation
#
# Als ".env" neben compose.yaml speichern.
# In Dockhand, Portainer oder einer anderen Compose-Oberfläche dieselben Werte
# als Stack-Umgebungsvariablen hinterlegen.

# Image:
#   latest = jeweils zuletzt veröffentlichtes Image
#   0.6.0 = feste veröffentlichte Version
RAB_IMAGE_TAG=latest

RAB_CONTAINER_NAME=rustdesk-addressbook
RAB_HOSTNAME=rustdesk-addressbook

# Persistente Hostpfade
RAB_DATA_DIR=/docker_data/rustdesk-addressbook/data
RAB_BACKUP_DIR=/docker_data/rustdesk-addressbook/backups

# Die Rechte werden beim Containerstart automatisch auf diese Projekt-UID/GID
# vorbereitet. Nur ändern, wenn das Image künftig ausdrücklich andere Werte nutzt.
RAB_RUNTIME_UID=10001
RAB_RUNTIME_GID=10001

# Standard: HTTPS aktiv, HTTP deaktiviert
RAB_HTTPS_BIND=0.0.0.0
RAB_HTTPS_PUBLISH_PORT=5443
APP_ENABLE_HTTPS=true

# Das Host-Port-Mapping 5055 ist in der einheitlichen Compose vorhanden.
# Erst APP_ENABLE_HTTP=true aktiviert den HTTP-Listener im Container.
RAB_HTTP_BIND=0.0.0.0
RAB_HTTP_PUBLISH_PORT=5055
APP_ENABLE_HTTP=false

# Eigene Zertifikate unter RAB_DATA_DIR/certs ablegen.
# Fehlen sie, erzeugt der Container automatisch ein selbstsigniertes Zertifikat.
HTTPS_CERT_FILE=/data/certs/addressbook.crt
HTTPS_KEY_FILE=/data/certs/addressbook.key
HTTPS_COMMON_NAME=rustdesk-addressbook.local
HTTPS_ALT_NAMES=localhost,127.0.0.1,rustdesk-addressbook.local

# Gunicorn
APP_WORKERS=1
APP_THREADS=4
APP_TIMEOUT=60

# Für direkten HTTPS-Betrieb empfohlen
SESSION_COOKIE_SECURE=true
APP_HSTS=false

# Nur hinter einem vertrauenswürdigen Reverse Proxy aktivieren.
TRUST_PROXY_HEADERS=false

# Login-Schutz und Sicherheitsprotokoll
LOGIN_FAIL_LIMIT=5
LOGIN_FAIL_WINDOW_SECONDS=900
AUTH_LOG_ROTATE_DAYS=7
AUTH_LOG_ROTATE_KEEP=8
AUTH_EVENT_RETENTION_DAYS=90
AUTH_EVENT_MAX_ROWS=50000
SENSITIVE_ACTION_REAUTH_SECONDS=1800

# Upload- und Backup-Grenzen
MAX_CONTENT_LENGTH=104857600
FULL_BACKUP_MAX_MEMBERS=5000
FULL_BACKUP_MAX_TOTAL_BYTES=536870912
FULL_BACKUP_MAX_FILE_BYTES=134217728

# Nur bewusst für einen privaten/lokalen OIDC-Issuer aktivieren.
OIDC_ALLOW_PRIVATE_ISSUER=false

# Das Setup-Token wird absichtlich nicht als Umgebungsvariable übergeben.
# Der Container erzeugt es zufällig in RAB_DATA_DIR/config.json. Nach erfolgreicher Erstellung des ersten Administrators wird es automatisch aus der Datei entfernt.

# Optionaler read-only Direktzugriff auf hbbs/db_v2.sqlite3.
# Beide Werte gemeinsam setzen. Die Hostdatei muss bereits existieren.
RUSTDESK_SERVER_DB_HOST_PATH=/dev/null
RUSTDESK_SERVER_DB=

# Beispiel:
# RUSTDESK_SERVER_DB_HOST_PATH=/docker_data/rustdesk/db_v2.sqlite3
# RUSTDESK_SERVER_DB=/rustdesk-server/db_v2.sqlite3

# Online-Update-Check für die weiterhin unterstützten signierten ZIP-Releases.
# Zum Abschalten: RAB_UPDATE_BASE_URL=disabled
RAB_UPDATE_BASE_URL=https://github.com/the-ab/RustDesk-AddressBook/releases/latest/download

TZ=Europe/Berlin
